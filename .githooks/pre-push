#!/bin/sh
# Hook pre-push : relance scripts/linux-check.sh sous WSL quand le push modifie server/,
# pour attraper les problèmes Linux (GCC/Clang, sanitizers, clang-format/clang-tidy) avant le CI.
#
# Installé via `git config core.hooksPath .githooks` (voir scripts/setup-claude.ps1, étape 10 de docs/SETUP.md).
# Sans WSL ou sans la distribution Ubuntu-24.04 : avertissement, mais push autorisé (le CI reste le filet).
# Contournement d'urgence : git push --no-verify (le CI vérifiera quand même).

zero=0000000000000000000000000000000000000000
touches_server=false

while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue # suppression de branche : rien à vérifier

    if [ "$remote_sha" = "$zero" ]; then
        # Nouvelle branche distante : compare depuis le point de divergence avec origin/main
        # (ou, à défaut, tout l'historique de la branche).
        if git rev-parse --verify --quiet origin/main >/dev/null; then
            base="$(git merge-base origin/main "$local_sha" 2>/dev/null)"
            range="${base:+$base..}$local_sha"
        else
            range="$local_sha"
        fi
    else
        range="$remote_sha..$local_sha"
    fi

    if git diff --name-only "$range" -- server/ 2>/dev/null | grep -q .; then
        touches_server=true
        break
    fi
done

if [ "$touches_server" != true ]; then
    exit 0
fi

echo "pre-push : le push modifie server/, vérification Linux (WSL) en cours..."

wsl_cmd=""
for candidate in wsl.exe wsl; do
    if command -v "$candidate" >/dev/null 2>&1; then
        wsl_cmd="$candidate"
        break
    fi
done

if [ -z "$wsl_cmd" ]; then
    echo "pre-push : AVERTISSEMENT — wsl introuvable, vérification Linux ignorée (le CI la fera)." >&2
    exit 0
fi

if ! "$wsl_cmd" -d Ubuntu-24.04 -- true >/dev/null 2>&1; then
    echo "pre-push : AVERTISSEMENT — distribution WSL Ubuntu-24.04 introuvable, vérification Linux ignorée (le CI la fera)." >&2
    echo "pre-push : voir docs/SETUP.md, étape 10, pour l'installer." >&2
    exit 0
fi

if ! "$wsl_cmd" -d Ubuntu-24.04 -- bash scripts/linux-check.sh; then
    echo "pre-push : ÉCHEC de scripts/linux-check.sh — push bloqué." >&2
    echo "pre-push : contournement d'urgence : git push --no-verify (le CI vérifiera quand même)." >&2
    exit 1
fi

exit 0
