root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cpp,hpp,h,cc,ixx}]
indent_size = 4

[{CMakeLists.txt,*.cmake}]
indent_size = 4

[*.md]
# Deux espaces en fin de ligne = saut de ligne Markdown
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf

[*.ps1]
charset = utf-8-bom
