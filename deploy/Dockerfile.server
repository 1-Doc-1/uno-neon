# Serveur de jeu NOC : build C++ Release (SANS crochets de test) puis image d'exécution minimale (ADR 0044).
# Contexte de construction : la racine du dépôt.   docker build -f deploy/Dockerfile.server -t noc-server .

# ---- 1. Construction --------------------------------------------------------------------------------------------
FROM ubuntu:24.04 AS build

# Même commit que la builtin-baseline de server/vcpkg.json.
ARG VCPKG_COMMIT=4cb050be2cfa7a947cdd2dd1a70e24b17774c979
ENV DEBIAN_FRONTEND=noninteractive \
    VCPKG_ROOT=/opt/vcpkg \
    VCPKG_DISABLE_METRICS=1 \
    CC=gcc-14 \
    CXX=g++-14

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates curl git zip unzip tar make perl pkg-config cmake ninja-build g++-14 \
        autoconf autoconf-archive automake libtool linux-libc-dev \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --filter=blob:none https://github.com/microsoft/vcpkg "$VCPKG_ROOT" \
    && git -C "$VCPKG_ROOT" checkout "$VCPKG_COMMIT" \
    && "$VCPKG_ROOT/bootstrap-vcpkg.sh" -disableMetrics

# Les dépendances d'abord : cette couche ne change que si vcpkg.json change.
WORKDIR /src/server
COPY server/vcpkg.json ./vcpkg.json
RUN "$VCPKG_ROOT/vcpkg" install --triplet x64-linux --x-manifest-root=/src/server --x-install-root=/opt/vcpkg_installed

COPY server/ ./
# UNO_ENABLE_TEST_HOOKS=OFF : aucun crochet de test dans l'image (vérifié par deploy/smoke-test.sh).
# libstdc++ et libgcc statiques : l'image d'exécution n'a besoin que de la libc.
RUN cmake -S . -B /build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_TOOLCHAIN_FILE="$VCPKG_ROOT/scripts/buildsystems/vcpkg.cmake" \
        -DVCPKG_TARGET_TRIPLET=x64-linux \
        -DVCPKG_MANIFEST_INSTALL=OFF \
        -DVCPKG_INSTALLED_DIR=/opt/vcpkg_installed \
        -DUNO_BUILD_TESTS=OFF \
        -DUNO_ENABLE_TEST_HOOKS=OFF \
        -DCMAKE_EXE_LINKER_FLAGS="-static-libstdc++ -static-libgcc" \
    && cmake --build /build --target uno_server \
    && strip /build/uno_server \
    && ldd /build/uno_server

# ---- 2. Exécution -----------------------------------------------------------------------------------------------
FROM debian:trixie-slim AS runtime

RUN groupadd --system --gid 10001 noc \
    && useradd --system --uid 10001 --gid noc --no-create-home --shell /usr/sbin/nologin noc

COPY --from=build /build/uno_server /app/uno_server

USER 10001:10001
# Le serveur écoute sur toutes les interfaces DU CONTENEUR : aucun port n'est publié, seul Caddy l'atteint (docker-compose.yml).
ENV UNO_PORT=9001 \
    UNO_BIND_ADDRESS=0.0.0.0
EXPOSE 9001

# Ni curl ni wget dans l'image : bash sait ouvrir une connexion TCP (/dev/tcp) et grep lit la première ligne de la réponse.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["bash", "-c", "exec 3<>/dev/tcp/127.0.0.1/${UNO_PORT:-9001}; printf 'GET /sante HTTP/1.1\\r\\nHost: sante\\r\\nConnection: close\\r\\n\\r\\n' >&3; head -n 1 <&3 | grep -q ' 200 '"]

ENTRYPOINT ["/app/uno_server"]
